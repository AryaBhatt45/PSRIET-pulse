# PostgreSQL connection string for the application database.
DATABASE_URL=postgresql://username:password@host:5432/database

# Configure both values to enable admin login and protected certification review.
ADMIN_PASSCODE=replace-with-a-strong-admin-passcode
JWT_SECRET=replace-with-at-least-32-random-characters

# SMTP settings used for claim receipts and approved certificates.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-mail-provider-password
SMTP_FROM="PTSRIET Pulse <mailer@example.com>"

PORT=5000
